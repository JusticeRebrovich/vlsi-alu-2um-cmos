Version 4.1
SHEET 1 888 4116
TEXT 0 48 Left 2 !* 1-bit ALU using three 2:1 MUX\n* Inputs: A, B, Cin, S0, S1\n* Outputs: Result, Cout\n \n*-------------------------------\n* Supply\n*-------------------------------\nVDD VDD 0 DC 1.8\nVSS 0 0 DC 0\n \n*-------------------------------\n* Input sources\n*-------------------------------\nVA  A  0 PULSE(0 1.8 0 1n 1n 20n 40n)\nVB  B  0 PULSE(0 1.8 0 1n 1n 40n 80n)\nVCin Cin 0 PULSE(0 1.8 0 1n 1n 80n 160n)\nVS0 S0 0 PULSE(0 1.8 0 1n 1n 160n 320n)\nVS1 S1 0 PULSE(0 1.8 0 1n 1n 320n 640n)\n \n*-------------------------------\n* AND gate (A AND B)\n*-------------------------------\nXAND A B AND_OUT AND_GATE\n \n*-------------------------------\n* OR gate (A OR B)\n*-------------------------------\nXOR1 A B OR_OUT OR_GATE\n \n*-------------------------------\n* Full Adder\n*-------------------------------\nXSUM A B Cin SUM_OUT Cout FULL_ADDER\n \n*-------------------------------\n* MUX level 1\n* S0=0 selects AND, S0=1 selects OR\n*-------------------------------\nXMUX1 AND_OUT OR_OUT S0 MUX1_OUT MUX21\n \n*-------------------------------\n* MUX level 2\n* S0=0 selects AND, S0=1 selects SUM\n*-------------------------------\nXMUX2 AND_OUT SUM_OUT S0 MUX2_OUT MUX21\n \n*-------------------------------\n* MUX level 3 final output\n* S1=0 selects MUX1, S1=1 selects MUX2\n*-------------------------------\nXMUX3 MUX1_OUT MUX2_OUT S1 Result MUX21\n \n*-------------------------------\n* 2:1 MUX subcircuit\n* SEL=0 gives I0, SEL=1 gives I1\n*-------------------------------\n.subckt MUX21 I0 I1 SEL OUT\nXINV_SEL SEL SELB INV\nXN1 I0 SELB N1 NAND2\nXN2 I1 SEL  N2 NAND2\nXN3 N1 N2  OUT NAND2\n.ends MUX21\n \n*-------------------------------\n* AND gate subcircuit\n*-------------------------------\n.subckt AND_GATE A B OUT\nXN1 A B N1 NAND2\nXINV N1 OUT INV\n.ends AND_GATE\n \n*-------------------------------\n* OR gate subcircuit\n*-------------------------------\n.subckt OR_GATE A B OUT\nXINV_A A ABAR INV\nXINV_B B BBAR INV\nXN1 ABAR BBAR N1 NAND2\nXINV_OUT N1 OUT INV\n.ends OR_GATE\n \n*-------------------------------\n* Full Adder subcircuit\n*-------------------------------\n.subckt FULL_ADDER A B Cin SUM Cout\nXXOR1 A B XAB XOR_GATE\nXXOR2 XAB Cin SUM XOR_GATE\nXAND1 A B AB AND_GATE\nXAND2 Cin XAB CinXAB AND_GATE\nXOR1 AB CinXAB Cout OR_GATE\n.ends FULL_ADDER\n \n*-------------------------------\n* XOR gate subcircuit\n*-------------------------------\n.subckt XOR_GATE A B OUT\nXN1 A B  N1 NAND2\nXN2 A N1 N2 NAND2\nXN3 B N1 N3 NAND2\nXN4 N2 N3 OUT NAND2\n.ends XOR_GATE\n \n*-------------------------------\n* NAND2 subcircuit\n*-------------------------------\n.subckt NAND2 A B OUT\nMP1 OUT A VDD VDD PMOS W=2u L=0.18u\nMP2 OUT B VDD VDD PMOS W=2u L=0.18u\nMN1 OUT A MID 0 NMOS W=1u L=0.18u\nMN2 MID B 0   0 NMOS W=1u L=0.18u\n.ends NAND2\n \n*-------------------------------\n* INV subcircuit\n*-------------------------------\n.subckt INV IN OUT\nMP1 OUT IN VDD VDD PMOS W=2u L=0.18u\nMN1 OUT IN 0   0   NMOS W=1u L=0.18u\n.ends INV\n \n*-------------------------------\n* MOSFET models\n*-------------------------------\n.model NMOS NMOS LEVEL=1 VT0=0.5 KP=120u LAMBDA=0.01\n.model PMOS PMOS LEVEL=1 VT0=-0.5 KP=60u LAMBDA=0.01\n \n*-------------------------------\n* Simulation command\n*-------------------------------\n.tran 1n 640n\n \n.end
